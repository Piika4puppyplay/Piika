+ * on dresse un second mur en C qui REPRODUIT à l'identique les bornes de
+ * system/pupdate/jail.rs (Limites::DEFAUT). Deux murs indépendants : « même
+ * PuppyOS doit se méfier de PuppyOS ». Toute modification de ces valeurs doit
+ * rester synchronisée avec jail.rs. */
+#define BOMBE_TAILLE_TOTALE_MAX  (512ull * 1024 * 1024) /* somme décompressée   */
+#define BOMBE_FICHIERS_MAX       20000u                 /* nombre d'entrées     */
+#define BOMBE_FICHIER_MAX        (256ull * 1024 * 1024) /* une entrée           */
+#define BOMBE_PROFONDEUR_MAX     32u                    /* segments de chemin   */
+#define BOMBE_CHEMIN_OCTETS_MAX  255u                   /* longueur du chemin   */
+#define BOMBE_RATIO_MAX          200ull                 /* décompressé/compressé*/
+#define BOMBE_RATIO_PLANCHER     (16ull * 1024)         /* seuil d'armement     */
+
+/* Profondeur d'un chemin relatif = nombre de segments non vides. */
+static unsigned profondeur_chemin(const char *p)
+{
+    unsigned n = 0;
+    for (const char *s = p; *s;) {
+        const char *f = strchr(s, '/');
+        size_t l = f ? (size_t)(f - s) : strlen(s);
+        if (l) n++;
+        if (!f) break;
+        s = f + 1;
+    }
+    return n;
+}
+
+/* Bornes d'UNE entrée (chemin + taille décompressée). 0 = acceptable. */
+static int bombe_entree_ok(const char *rel, uint64_t taille)
+{
+    size_t l = strlen(rel);
+    if (l == 0 || l > BOMBE_CHEMIN_OCTETS_MAX) return 0;
+    unsigned prof = profondeur_chemin(rel);
+    if (prof == 0 || prof > BOMBE_PROFONDEUR_MAX) return 0;
+    if (taille > BOMBE_FICHIER_MAX) return 0;
+    return 1;
+}
+
+/* Bornes de CUMUL (nb d'entrées, total décompressé, taille du .puppy). 0 = ok. */
+static int bombe_cumul_ok(uint32_t nb, uint64_t total, uint64_t compressee)
+{
+    if (nb > BOMBE_FICHIERS_MAX) return 0;
+    if (total > BOMBE_TAILLE_TOTALE_MAX) return 0;
+    if (compressee > 0 && total / (compressee ? compressee : 1) > BOMBE_RATIO_MAX
+        && total > BOMBE_RATIO_PLANCHER) return 0;
+    return 1;
+}
