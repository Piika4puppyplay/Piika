+/* 0.20 : exécute l'autorité CONFINÉE paquets-autorite et renvoie son code
+ * (AUT_OK / AUT_REFUSE / AUT_ERREUR). Sa ligne de sortie va dans `msg`. Un
+ * processus tué (seccomp) compte comme un échec. */
+static int poser_confine(const char *mode, int genre, const char *id, const char *paquet, int systeme,
+                         char *msg, size_t nmsg)
+{
+    char g[4], sys[4];
+    snprintf(g, sizeof g, "%d", genre);
+    snprintf(sys, sizeof sys, "%d", systeme);
+    int p[2];
+    if (pipe2(p, O_CLOEXEC) < 0) return AUT_ERREUR;
+    pid_t pid = fork();
+    if (pid == 0) {
+        int nul = open("/dev/null", O_RDONLY);
+        if (nul >= 0) dup2(nul, 0);
+        dup2(p[1], 1);
+        int log = open(PUPPY_RUN "/autorite.log", O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+        if (log >= 0) dup2(log, 2);
+        signal(SIGCHLD, SIG_DFL);
+        signal(SIGPIPE, SIG_DFL);
+        clearenv();
+        char *argv[8];
+        int n = 0;
+        argv[n++] = "paquets-autorite";
+        argv[n++] = (char *)mode;
+        argv[n++] = g;
+        argv[n++] = (char *)id;
+        if (paquet) {
+            argv[n++] = (char *)paquet;
+            argv[n++] = sys;
+        }
+        argv[n] = NULL;
+        execv(PUPPY_ACTUEL "/bin/paquets-autorite", argv);
+        _exit(127);
